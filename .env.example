# SARASWATI SAMMAN — Multi-Samaj Education Award Management System
# Database Architecture: Android SQLite (Room) + Google Sheets Cloud Database
# (No MongoDB, No Firebase, No SMS Gateway required)

# Google Sheets Database Configuration
# Default Spreadsheet ID for Saraswati Samman community records:
GOOGLE_SHEET_ID=1saraswati_samman_awards_database_master_sheet_id
GOOGLE_SHEETS_API_URL=https://sheets.googleapis.com/v4/spreadsheets

# Android SQLite Database Name
SQLITE_DB_NAME=saraswati_samman.db
